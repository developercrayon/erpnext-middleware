replace\",\n    \"path\": \"/attributes/assembly_instructions\",\n    \"value\": [\n      {\n        \"value\": \"Mount The Shelf On The Wall Using The Provided Hardware. Mark The Desired Position On The Wall, Drill Holes At The Marked Points, Insert Wall Plugs, And Secure The Shelf Using Screws. Ensure The Shelf Is Level Before Tightening Fully.\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/item_depth_width_height\",\n    \"value\": [\n      {\n        \"depth\": {\n          \"unit\": \"centimeters\",\n          \"value\": 10\n        },\n        \"width\": {\n          \"unit\": \"centimeters\",\n          \"value\": 61\n        },\n        \"height\": {\n          \"unit\": \"centimeters\",\n          \"value\": 61\n        },\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/item_package_dimensions\",\n    \"value\": [\n      {\n        \"width\": {\n          \"unit\": \"centimeters\",\n          \"value\": 64\n        },\n        \"height\": {\n          \"unit\": \"centimeters\",\n          \"value\": 64\n        },\n        \"length\": {\n          \"unit\": \"centimeters\",\n          \"value\": 10\n        },\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/merchant_shipping_group\",\n    \"value\": [\n      {\n        \"value\": \"legacy-template-id\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/merchant_suggested_asin\",\n    \"value\": [\n      {\n        \"value\": \"B0H6J6Y2CV\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/fulfillment_availability\",\n    \"value\": [\n      {\n        \"quantity\": 0,\n  