n      {\n        \"value\": 1,\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/shelf_thickness\",\n    \"value\": [\n      {\n        \"unit\": \"centemeter\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/special_feature\",\n    \"value\": [\n      {\n        \"value\": \"Individual Compartments\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/variation_theme\",\n    \"value\": [\n      {\n        \"name\": \"COLOR\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/weight_capacity\",\n    \"value\": [\n      {\n        \"maximum\": [\n          {\n            \"unit\": \"grams\",\n            \"value\": 15\n          }\n        ],\n        \"minimum\": [\n          {\n            \"unit\": \"grams\",\n            \"value\": 10\n          }\n        ],\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/furniture_finish\",\n    \"value\": [\n      {\n        \"value\": \"Natural Clear Matte Finish\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/number_of_pieces\",\n    \"value\": [\n      {\n        \"value\": 1,\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/care_instructions\",\n    \"value\": [\n      {\n        \"value\": \"Wipe Clean With A Dry Or Slightly Damp Cloth\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/installation_type\",\n    \"value\": [\n      {\n        \"value\": \"Wall Mounted\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/number_of_shelves\",\n    \"value\": [\n      {\n        \"value\": \"15\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/included_components\",\n    \"value\": [\n      {\n        \"value\": \"Wooden Wall Display Shelf\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      },\n      {\n        \"value\": \"Comes with Durable Metal Hooks, Mounting Screws for Easy Wall Installation.\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/item_package_weight\",\n    \"value\": [\n      {\n        \"unit\": \"grams\",\n        \"value\": 2800,\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/product_description\",\n    \"value\": [\n      {\n        \"value\": \"Transform any bare wall into a stunning focal point with this beautifully crafted wooden wall shelf, featuring a distinctive grid-like lattice design that is as functional as it is eye-catching. Made from Pine wood in a warm natural Clear Matte finish, this wall-mounted shelf unit offers multiple open compartments of varying depths, perfect for displaying mugs, small plants, decorative items, books, and more. The unique cross-hatch pattern creates an artistic silhouette that complements both modern and Luxury interiors with effortless charm. Ideal for kitchens, living rooms, home offices, or entryways, this versatile shelf helps you organise your space whilst adding a touch of warmth and character to your décor. The sturdy wooden construction ensures long-lasting durability, and the open design keeps your favourite items within easy reach and beautifully on display. Whether used as a coffee mug rack, a display shelf for collectibles, or a stylish organiser, this wall shelf is a practical and decorative addition to any home.\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/shelf_bracket_shape\",\n    \"value\": [\n      {\n        \"value\": \"grid-like lattice design\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/is_assembly_required\",\n    \"value\": [\n      {\n        \"value\": true,\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/assembly_instructions\",\n    \"value\": [\n      {\n        \"value\": \"Mount The Shelf On The Wall Using The Provided Hardware. Mark The Desired Position On The Wall, Drill Holes At The Marked Points, Insert Wall Plugs, And Secure The Shelf Using Screws. Ensure The Shelf Is Level Before Tightening Fully.\",\n        \"language_tag\": \"en_IN\",\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/item_depth_width_height\",\n    \"value\": [\n      {\n        \"depth\": {\n          \"unit\": \"centimeters\",\n          \"value\": 10\n        },\n        \"width\": {\n          \"unit\": \"centimeters\",\n          \"value\": 61\n        },\n        \"height\": {\n          \"unit\": \"centimeters\",\n          \"value\": 61\n        },\n        \"marketplace_id\": \"A21TJRUUN4KGV\"\n      }\n    ]\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/attributes/item_package_dimensions\",\n    \"value\": [\n      {\n        \"width\": {\n 